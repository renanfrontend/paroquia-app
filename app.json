{
  "expo": {
    "name": "Paróquia Conectada",
    "slug": "paroquia-conectada",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.paroquiaconectada.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#dc2626"
      },
      "package": "com.paroquiaconectada.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Paróquia Conectada"
    },
    "scheme": "paroquiaconectada",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#dc2626"
        }
      ],
      "expo-router"
    ],
    "experiments": {},
    "extra": {
      "router": {
        "origin": false
      }
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#dc2626"
    },
    "icon": "./assets/icon.png"
  }
}
