# Supabase Configuration
# Obtenha essas credenciais em https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=seu-chave-anonima-publica

# API de Liturgia Diária (opcional)
# Para sincronizar liturgia via Edge Function
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-do-servidor

# Configuração Expo
EXPO_PUBLIC_APP_NAME=Paróquia Conectada
EXPO_PUBLIC_APP_VERSION=1.0.0
